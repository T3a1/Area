{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh pr review * -a *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)"
    ]
  }
}
